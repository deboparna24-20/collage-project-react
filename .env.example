# GEMINI_API_KEY: Optional runtime secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Express server port (use a different free port if 3000 is occupied)
PORT="3000"

# MySQL Database Configuration (Estorvix Real Estate System)
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="estorvix_db"
